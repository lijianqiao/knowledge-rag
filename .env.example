# ===== 基础 =====
OPENAI_API_KEY=your_openai_api_key
CHROMA_DB_PATH=./chroma_db
COLLECTION_NAME=ops_knowledge

# ===== Embedding 服务（llama.cpp --embedding）=====
EMBED_BASE_URL=http://127.0.0.1:8080/v1
EMBED_MODEL=Qwen3-Embedding-0.6B

# ===== Chat 服务（llama.cpp 对话模型）=====
CHAT_BASE_URL=http://127.0.0.1:8081/v1
CHAT_MODEL=Qwen3.5-9B
LLM_TIMEOUT=600
LLM_MAX_TOKENS=1024
CONTEXT_CHUNK_MAX_CHARS=1200

# ===== LLM/Embedding 提供方切换（local llama.cpp | cloud OpenAI 兼容云端点）=====
# 默认全 local（不设 = 走上面本地 llama.cpp）；chat 与 embed 可独立切换（如云 chat + 本地 embed）。
# CHAT_PROVIDER=local                      # local | cloud
# EMBED_PROVIDER=local                     # local | cloud
#
# 云端 Chat（任一 OpenAI 兼容厂商：DeepSeek / DashScope / Moonshot / 智谱 / OpenAI）
# CLOUD_CHAT_BASE_URL=https://api.deepseek.com/v1
# CLOUD_CHAT_MODEL=deepseek-chat
# CLOUD_CHAT_API_KEY=sk-your-cloud-chat-key
#
# 云端 Embedding
# !!! 警告：切换 EMBED_PROVIDER 会改变向量维度，旧 Chroma collection 不兼容，
# !!! 必须 uv run python main.py import --force 删表重灌，否则检索报维度不匹配。
# CLOUD_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CLOUD_EMBED_MODEL=text-embedding-v3
# CLOUD_EMBED_API_KEY=sk-your-cloud-embed-key

# ===== 检索 / 分块 =====
RETRIEVE_TOP_K=5
MAX_RETRIEVE_RETRIES=2
RETRIEVE_SCORE_THRESHOLD=0.35
RETRIEVE_CANDIDATE_K=30
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ===== 数据源清单 =====
SOURCES_CONFIG_PATH=sources.toml

# ===== Reranker（GGUF 只能走 api 后端：llama.cpp --reranking 的 /rerank）=====
ENABLE_RERANK=true
RERANK_BACKEND=api                       # api | local
RERANK_BASE_URL=http://127.0.0.1:8082
RERANK_API_MODEL=bge-reranker-v2-m3      # 单模型 llama.cpp 会忽略该名，仅作标签
RERANK_MODEL=BAAI/bge-reranker-v2-m3     # 仅 RERANK_BACKEND=local 时使用（需 HF 格式权重，非 GGUF）

# ===== Hybrid 检索（稠密 + BM25 融合）=====
ENABLE_HYBRID=true
BM25_TOP_K=30

# ===== 查询改写（弱重试时）/ 多查询扩展（首检索时）=====
ENABLE_QUERY_REWRITE=true
ENABLE_MULTI_QUERY=false
MULTI_QUERY_NUM=3

# ===== GraphRAG（默认关闭：需先 uv run python main.py graph-build 构建图谱）=====
ENABLE_GRAPH=false                       # 开启后 ask 按问题类型自动路由 图/向量
GRAPH_PERSIST_DIR=./graph_store          # 图谱持久化目录（整 StorageContext）
GRAPH_RETRIEVE_TOP_K=8                   # 图检索召回条数
GRAPH_MAX_PATHS_PER_CHUNK=10             # 每个 chunk 抽取的最大三元组数

# ===== 跨文档推理 Agent（默认关闭）=====
ENABLE_AGENT=false                       # 仅影响 agent 子命令（独立多步入口）
MAX_AGENT_STEPS=4                        # Agent 最大决策步数
